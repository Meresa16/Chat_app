# Application
PORT=5000
NODE_ENV=development

# Oracle Database Configuration
ORACLE_USER=system
ORACLE_PASSWORD=123456
ORACLE_CONNECT_STRING=localhost:1522/XEPDB1

# Example:
# ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
# or if using containerized Oracle:
# ORACLE_CONNECT_STRING=oracle-db:1521/ORCLPDB1

# JWT or Security
JWT_SECRET=your_jwt_secret_here

# Logging / Debug
LOG_LEVEL=info



# DB_USER=system
# DB_PASSWORD=123456
# DB_HOST=localhost
# DB_PORT=1522
# DB_SERVICE=XEPDB1
